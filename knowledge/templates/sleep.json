{
  "template_name": "睡眠障碍分析模板",
  "disease_type": "sleep",
  "description": "基于PSQI/ISI的睡眠障碍标准化分析模板，覆盖睡眠质量评估、睡眠-情绪关联、用药与睡眠改善",
  "scales": [
    {
      "name": "PSQI",
      "full_name": "Pittsburgh Sleep Quality Index",
      "items": 19,
      "range": "0-21",
      "reference": "Buysse DJ et al (1989) Psychiatry Res 28:193-213",
      "severity": {
        "good_sleep": 5
      },
      "components": [
        "subjective_sleep_quality",
        "sleep_latency",
        "sleep_duration",
        "habitual_sleep_efficiency",
        "sleep_disturbances",
        "sleep_medication_use",
        "daytime_dysfunction"
      ]
    },
    {
      "name": "ISI",
      "full_name": "Insomnia Severity Index",
      "items": 7,
      "range": "0-28",
      "reference": "Morin CM et al (2011) Sleep 34:601-608",
      "severity": {
        "no_insomnia": 7,
        "subthreshold": 14,
        "moderate": 21,
        "severe": 28
      }
    }
  ],
  "analysis_steps": [
    {
      "step": 1,
      "name": "数据质控",
      "operator": "missing_summary",
      "description": "缺失率/数据类型/唯一值统计"
    },
    {
      "step": 2,
      "name": "异常值检测",
      "operator": "outlier_iqr_flag",
      "description": "Tukey IQR围栏标记"
    },
    {
      "step": 3,
      "name": "缺失值填补",
      "operator": "data_imputation",
      "description": "median填补策略"
    },
    {
      "step": 4,
      "name": "PSQI成分分析",
      "operator": "describe_full",
      "description": "7个成分分: sleep_quality/latency/duration/efficiency/disturbances/medication/daytime"
    },
    {
      "step": 5,
      "name": "分布直方图",
      "operator": "distribution_histogram",
      "description": "等宽直方图数据"
    },
    {
      "step": 6,
      "name": "睡眠-情绪关联",
      "operator": "correlation",
      "description": "PSQI与HAMD/HAMA/PHQ-9的Pearson/Spearman相关"
    },
    {
      "step": 7,
      "name": "偏相关分析",
      "operator": "partial_correlation",
      "description": "控制年龄/性别后睡眠与情绪的净相关"
    },
    {
      "step": 8,
      "name": "用药与睡眠改善",
      "operator": "ordinal_regression",
      "description": "镇静催眠药对PSQI各成分的改善效果"
    },
    {
      "step": 9,
      "name": "时间序列特征",
      "operator": "time_series_features",
      "description": "PSQI总分随时间变化趋势"
    }
  ],
  "report_structure": [
    "研究对象基本信息",
    "数据质控结果",
    "PSQI睡眠质量分析",
    "睡眠-情绪关联分析",
    "用药与睡眠改善",
    "结论与建议"
  ],
  "version": "2.0.0",
  "last_updated": "2025-06-30"
}