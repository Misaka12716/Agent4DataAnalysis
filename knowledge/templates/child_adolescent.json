{
  "template_name": "儿童青少年精神障碍分析模板",
  "disease_type": "child_adolescent",
  "description": "基于CBCL/CDRS-R/ADHD-RS的儿童青少年精神障碍标准化分析模板，覆盖量表分析、发育轨迹、ADHD双维度与家庭因素关联",
  "scales": [
    {
      "name": "CBCL",
      "full_name": "Child Behavior Checklist (6-18 years)",
      "items": 113,
      "range": "T-scores (mean=50, SD=10)",
      "reference": "Achenbach TM, Rescorla LA (2001) ASEBA",
      "syndrome_scales": [
        "anxious_depressed",
        "withdrawn_depressed",
        "somatic_complaints",
        "social_problems",
        "thought_problems",
        "attention_problems",
        "rule_breaking_behavior",
        "aggressive_behavior"
      ],
      "broadband_scales": [
        "internalizing",
        "externalizing",
        "total_problems"
      ]
    },
    {
      "name": "CDRS-R",
      "full_name": "Children's Depression Rating Scale-Revised",
      "items": 17,
      "range": "17-113",
      "reference": "Poznanski EO, Mokros HB (1996) Western Psychological Services",
      "severity": {
        "indicative": 30,
        "significant": 40
      }
    },
    {
      "name": "ADHD-RS",
      "full_name": "ADHD Rating Scale-IV",
      "items": 18,
      "range": "0-54",
      "reference": "DuPaul GJ et al (1998) Guilford Press",
      "subscales": [
        {
          "name": "inattention",
          "items": 9
        },
        {
          "name": "hyperactivity_impulsivity",
          "items": 9
        }
      ]
    }
  ],
  "analysis_steps": [
    {
      "step": 1,
      "name": "数据质控",
      "operator": "missing_summary",
      "description": "缺失率/数据类型/唯一值统计"
    },
    {
      "step": 2,
      "name": "异常值检测",
      "operator": "outlier_iqr_flag",
      "description": "Tukey IQR围栏标记"
    },
    {
      "step": 3,
      "name": "缺失值填补",
      "operator": "data_imputation",
      "description": "median填补策略"
    },
    {
      "step": 4,
      "name": "CBCL量表分析",
      "operator": "describe_full",
      "description": "8个综合征量表+2个宽带量表(internalizing/externalizing)"
    },
    {
      "step": 5,
      "name": "分布直方图",
      "operator": "distribution_histogram",
      "description": "等宽直方图数据"
    },
    {
      "step": 6,
      "name": "发育轨迹分析",
      "operator": "latent_growth_curve",
      "description": "潜变量增长曲线模型, 年龄x症状严重度交互作用"
    },
    {
      "step": 7,
      "name": "ADHD注意力分析",
      "operator": "ordinal_regression",
      "description": "ADHD-RS inattention vs hyperactivity/impulsivity双维度"
    },
    {
      "step": 8,
      "name": "家庭/学校因素关联",
      "operator": "correlation",
      "description": "家庭环境因素与症状严重度的Pearson/Spearman相关"
    },
    {
      "step": 9,
      "name": "组间差异检验",
      "operator": "hypothesis_tests",
      "description": "不同性别/年龄组的CBCL得分差异(Welch t/ANOVA)"
    }
  ],
  "report_structure": [
    "研究对象基本信息",
    "数据质控结果",
    "CBCL量表分析",
    "发育轨迹分析",
    "ADHD注意力分析",
    "家庭/学校因素关联",
    "结论与建议"
  ],
  "version": "2.0.0",
  "last_updated": "2025-06-30"
}