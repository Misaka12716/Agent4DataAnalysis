# LLM（本地 Ollama 三模型：通用文本 / Coder / Vision）
# 权威来源：本文件；src/configs/config.py 仅 os.getenv 转发
# 主键：OPENAI_API_*；旧名 API_KEY / OPENAI_COMPATIBLE_API_BASE 仍可作兼容覆盖
# 详见 docs/Models.md
OPENAI_API_KEY=ollama
OPENAI_API_BASE=http://192.168.4.110:12716/v1
LLM_MODEL=glm-4.7-flash:q4_K_M
DEFAULT_MODEL=glm-4.7-flash:q4_K_M
DEFAULT_CODER_MODEL=qwen3-coder:30b
DEFAULT_VISION_MODEL=deepseek-ocr:latest
CLINICAL_REPORT_MODEL=glm-4.7-flash:q4_K_M
# DEFAULT_ORCHESTRATOR_MODEL=  # 省略则跟随 DEFAULT_MODEL
# DEFAULT_READER_MODEL=        # 省略则跟随 DEFAULT_MODEL
# LLM_REQUEST_TIMEOUT=180      # 单次 LLM 请求超时（秒）

# 执行 Runtime（默认本地）
CUBE_SANDBOX_ENABLED=0
# Worker 代码执行解释器：须已装 requirements-runner.txt
# 推荐专用环境：RUNNER_PYTHON=/data/pjw/.conda/envs/agentPlatform-runner/bin/python
# （conda base 不可改名；勿把 base 当作专用 Runner）
RUNNER_PYTHON=
RUNTIME_COMMAND_TIMEOUT=300
RUNTIME_MAX_OUTPUT_CHARS=524288

# Cube Sandbox（可选，CUBE_SANDBOX_ENABLED=1 时启用）
# E2B_API_URL=http://127.0.0.1:3000
# E2B_API_KEY=e2b_000000
# CUBE_TEMPLATE_ID=tpl-78c1861fc2b54381947d33e2
# SANDBOX_WORKDIR=/home/user
# SANDBOX_TIMEOUT=600
# 使用 Cube 内置 mkcert HTTPS 时取消注释：
# SSL_CERT_FILE=/root/.local/share/mkcert/rootCA.pem

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=agent_platform
MYSQL_CHARSET=utf8mb4

# 个人资源管理（文件空间 / 数据集 / 模型库）
# RESOURCES_ROOT=/data1/pjw/AgentPlatform/tmp/resources
# RESOURCES_MAX_UPLOAD_MB=2048
# RESOURCES_PREVIEW_ROWS=50
# RESOURCES_PREDICT_MAX_ROWS=5000
# ACCEPTANCE_MODE=1
