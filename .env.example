# 执行 Runtime（默认本地）
CUBE_SANDBOX_ENABLED=0
RUNNER_PYTHON=
# 安装 Runner 后示例：
# RUNNER_PYTHON=/path/to/conda/envs/agentPlatform-runner/bin/python
RUNTIME_COMMAND_TIMEOUT=300
RUNTIME_MAX_OUTPUT_CHARS=524288

# Cube Sandbox（可选，CUBE_SANDBOX_ENABLED=1 时启用）
# E2B_API_URL=http://127.0.0.1:3000
# E2B_API_KEY=e2b_000000
# CUBE_TEMPLATE_ID=tpl-78c1861fc2b54381947d33e2
# SANDBOX_WORKDIR=/home/user
# SANDBOX_TIMEOUT=600
# 使用 Cube 内置 mkcert HTTPS 时取消注释：
# SSL_CERT_FILE=/root/.local/share/mkcert/rootCA.pem
